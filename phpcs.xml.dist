<?xml version="1.0"?>
<ruleset name="HeyWoo">
    <description>WordPress-Extra + WordPress-Docs + WooCommerce coding standards for Hey Woo.</description>

    <file>hey-woo.php</file>
    <file>includes</file>
    <file>php-packages/commerce-abilities/src</file>
    <file>tests</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WooCommerce"/>

    <rule ref="WordPress.WP.I18n.TextDomainMismatch">
        <exclude-pattern>php-packages/commerce-abilities/src/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <config name="text_domain" value="hey-woo"/>
    <config name="minimum_supported_wp_version" value="6.9"/>
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <severity>0</severity>
    </rule>
</ruleset>
